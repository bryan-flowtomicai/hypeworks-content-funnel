# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# fal.ai
FAL_KEY=your-fal-ai-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# Cloudflare Browser Rendering (primary scraper — real headless Chrome)
# Create API token at dash.cloudflare.com → My Profile → API Tokens
# Required permission: Browser Rendering - Edit
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-cf-api-token

# Firecrawl (optional fallback scraper — used if Cloudflare creds are not set)
FIRECRAWL_API_KEY=fc-...

# Anthropic (Claude AI extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Admin (comma-separated emails that bypass credit limits)
ADMIN_EMAILS=you@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
